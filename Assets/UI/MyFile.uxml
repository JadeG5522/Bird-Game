<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="0" name="score-label" enabled="true" enable-rich-text="true" style="position: relative; top: auto; left: auto; width: 100%; height: 20%; font-size: 56px; -unity-text-align: upper-center; justify-content: center; color: rgb(255, 255, 255);"/>
    <ui:Label text="Game Over" name="game-over-label" enabled="true" style="-unity-text-align: upper-center; font-size: 53px; display: none; color: rgb(255, 255, 255);"/>
    <ui:Button text="Restart?" name="restart-button" enabled="true" style="font-size: 56px; display: none; width: 247px; justify-content: center; align-items: center; align-self: center; height: 88px; color: rgb(255, 255, 255); background-color: rgb(86, 135, 82);"/>
</ui:UXML>
